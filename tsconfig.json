{
  // TS 7.x + tsdown + vitest — see https://aka.ms/tsconfig
  "compilerOptions": {
    // Language & Environment
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,

    // Bundler mode — tsdown (Rolldown) handles emit; tsc is type-check only
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": false,

    // Emit: d.ts generated by tsdown (dts:true); keep sourceMap/declaration for IDE, tsc --noEmit will not write
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Strictness — TS7 defaults strict:true; keep stricter subset from existing config
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    // Interop / Safety — required for isolatedModules & verbatimModuleSyntax
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": false,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,

    // Test types — vitest globals + jsdom; add @types/node if Node APIs needed
    "types": ["vitest/globals", "vitest/jsdom"]
  },
  "include": ["src/**/*", "tsdown.config.ts", "vitest.config.ts", "vitest.setup.ts"],
  "exclude": ["node_modules", "dist", "build"]
}
